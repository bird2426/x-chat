# 阿里云百炼 API Key
# 用于 Qwen、GLM、Kimi、MiniMax 等百炼 OpenAI-compatible 模型。
# 获取地址: https://bailian.console.aliyun.com/
BAILIAN_API_KEY=xxx

# Google Gemini API Key
# 用于 Gemini Flash / Flash-Lite 多模态模型。
# 本地如设置 HTTPS_PROXY/HTTP_PROXY 会自动走代理；线上未设置代理时会直连 Google 接口。
GOOGLE_API_KEY=xxx

# Tavily 搜索 API Key（可选）
# 用于 search_web 工具获取真实网页搜索结果；不配置时会返回模拟搜索结果。
# 注册地址: https://tavily.com/
TAVILY_API_KEY=xxx

# Chat logging（可选）
# CHAT_LOG_LEVEL: debug | info | warn | error
# CHAT_LOG_TRANSCRIPT: 1 记录对话文本；0 不记录对话文本
# CHAT_LOG_REDACT: 1 对日志做脱敏；0 不脱敏
# CHAT_LOG_MAX_CHARS: 单条日志最多保留的字符数
CHAT_LOG_LEVEL=info
CHAT_LOG_TRANSCRIPT=0
CHAT_LOG_REDACT=1
CHAT_LOG_MAX_CHARS=8000
