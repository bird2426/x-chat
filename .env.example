# Google Gemini API Key
# 获取地址: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# 通义千问 (Qwen) API Key
# 获取地址: https://dashscope.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here
# Tavily 搜索 API Key (可选 - 用于真实网页搜索)
# 免费注册: https://tavily.com/
# 免费额度: 1000次/月
TAVILY_API_KEY=your_tavily_api_key_here

# Chat logging (optional)
# - Logs are one-line JSON to stdout/stderr.
# - Transcript logging is enabled by default in non-production; set explicitly in production.
CHAT_LOG_LEVEL=info            # debug|info|warn|error
CHAT_LOG_TRANSCRIPT=1          # 1=log full transcripts, 0=metadata only
CHAT_LOG_REDACT=1              # 1=best-effort redaction (recommended)
CHAT_LOG_MAX_CHARS=8000        # truncate long fields
